    q: Spain, colloquial
    syn: cuqui
  gloss: blond, blonde
    q: Colombia, colloquial
    syn: rubio
pos: n
  meta: {{es-noun|m|f=+}}
  g: m
  etymology: Haplographically from maimón (“monkey”), from Arabic "مَيْمُون" (“baboon, mandrill”). Compare English "monkey".
  gloss: monkey
    syn: chango; maimón; mico; simio; (Louisiana) macaco
  gloss: boiler suit, coveralls, overall, onesie (a one-piece suit combining trousers and jacket, worn for heavy or hot manual labour)
    syn: mono de trabajo; mameluco; braga; buzo; overol
  gloss: jumpsuit, overalls (a one-piece item of clothing originally by parachutists)
  gloss: jumpsuit (a female one-piece item of clothing)
  gloss: tracksuit, joggers (garment consisting of a top and trousers for sports and casual wear)
    q: Chile, Peru
    syn: buzo; chándal
  gloss: vagina, vulva
    q: Costa Rica, slang
  gloss: doll, puppet
    q: Mexico, Chile
    syn: muñeco
  gloss: doodle
    q: colloquial
    _gloss: cartoon
      q: in the plural
  gloss: withdrawal symptom
    q: colloquial
    syn: síndrome de abstinencia
